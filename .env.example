# Database
# DATABASE_URL — pooled connection for runtime (PgBouncer transaction mode, e.g. Supabase pooler :6543?pgbouncer=true)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asset_mgmt?schema=public?pgbouncer=true"
# DIRECT_URL — direct/session-mode connection for migrations and introspection (e.g. Supabase pooler :5432 or direct host)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/asset_mgmt?schema=public"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"